<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/next_event_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/next_widget_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/next_widget_heading"
        android:textColor="#BBDBCF"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/next_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/next_widget_empty"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/next_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/next_widget_open"
        android:textColor="#D9E9E2"
        android:textSize="12sp" />
</LinearLayout>
